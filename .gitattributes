# Git Attributes for Python 3 Integration Module
# Ensures consistent line endings and language detection across platforms

# Auto detect text files and normalize line endings
* text=auto

# Java source files
*.java text diff=java eol=lf
*.kt text diff=kotlin eol=lf
*.kts text diff=kotlin eol=lf

# Gradle build files
*.gradle text diff=java eol=lf
*.gradle.kts text diff=kotlin eol=lf
gradle.properties text eol=lf
gradlew text eol=lf
gradlew.bat text eol=crlf

# Python files
*.py text diff=python eol=lf

# Shell scripts (must use LF)
*.sh text eol=lf
*.bash text eol=lf

# Windows scripts (must use CRLF)
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Documentation
*.md text diff=markdown eol=lf
*.txt text eol=lf
*.adoc text eol=lf
*.rst text eol=lf

# Configuration files
*.xml text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.properties text eol=lf
*.conf text eol=lf

# Git files
.gitignore text eol=lf
.gitattributes text eol=lf
.gitmodules text eol=lf

# Binary files (never auto-convert line endings)
*.jar binary
*.modl binary
*.class binary
*.war binary
*.ear binary
*.zip binary
*.tar binary
*.gz binary
*.tgz binary
*.7z binary

# Images
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg binary
*.webp binary

# Certificates and keys
*.jks binary
*.der binary
*.cer binary
*.crt binary
*.pem binary
*.key binary
*.p12 binary
*.pfx binary

# Fonts
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.eot binary

# Documents
*.pdf binary
*.doc binary
*.docx binary
*.xls binary
*.xlsx binary

# Archives in git (not recommended but handle if present)
*.rar binary
*.cab binary
*.msi binary
*.dmg binary
*.iso binary

# GitHub linguist overrides for language detection
# (Helps GitHub correctly identify repository language)
*.gradle linguist-language=Gradle
build.gradle.kts linguist-language=Gradle
settings.gradle.kts linguist-language=Gradle
gradlew linguist-generated=true
gradlew.bat linguist-generated=true

# Exclude generated files from diff stats
build/ linguist-generated=true
.gradle/ linguist-generated=true
out/ linguist-generated=true
target/ linguist-generated=true

# Mark test fixtures as vendored (not counted in language stats)
**/test/fixtures/** linguist-vendored=true
**/testdata/** linguist-vendored=true

# Documentation directories (mark as documentation)
docs/** linguist-documentation=true
*.md linguist-documentation=true
