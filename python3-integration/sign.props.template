# Module Signing Configuration
# Copy this file to sign.props and fill in your actual values.
#
# For development: use self-signed certificates
# For production: use properly secured certificates with private passwords
#
# See CLAUDE.md "Certificate Management" section for full rationale.

# Keystore file (contains private key)
key.file=path/to/your/keystore.jks
key.pass=YOUR_KEYSTORE_PASSWORD_HERE

# Certificate file (public certificate)
cert.file=path/to/your/certificate.der
cert.alias=YOUR_CERT_ALIAS_HERE
cert.pass=YOUR_CERT_PASSWORD_HERE
