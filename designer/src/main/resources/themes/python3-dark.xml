<?xml version="1.0" encoding="UTF-8"?>
<!--
  RSyntaxTextArea theme for Python 3 IDE - VS Code Dark+ inspired
  v3.6.6: Shifted from cold navy-blacks to VS Code warm grays
-->
<RSyntaxTheme version="1.0">

   <!-- General editor colors -->
   <background color="1e1e1e"/>
   <caret color="d4d4d4"/>
   <selection useRoundedEdges="false" color="264f78"/>
   <currentLineHighlight color="282828" fade="false"/>
   <marginLine fg="2d2d30"/>
   <markAllHighlight color="264f78"/>
   <markOccurrencesHighlight color="264f78" border="false"/>
   <matchedBracket fg="569cd6" bg="264f78" highlightBoth="true" animate="true"/>
   <hyperlinks fg="569cd6"/>
   <secondaryLanguages>
      <language index="1" bg="1e1e1e"/>
      <language index="2" bg="1e1e1e"/>
      <language index="3" bg="1e1e1e"/>
   </secondaryLanguages>

   <!-- Gutter (line numbers) -->
   <gutterBackground color="1e1e1e"/>
   <gutterBorder color="2d2d30"/>
   <lineNumbers fg="858585"/>
   <foldIndicator fg="858585" iconBg="1e1e1e" iconArmedBg="252526"/>
   <iconRowHeader activeLineRange="569cd6"/>

   <!-- Token styles - VS Code Dark+ syntax colors -->
   <tokenStyles>
      <!-- Identifiers -->
      <style token="IDENTIFIER" fg="d4d4d4"/>

      <!-- Data types and annotations -->
      <style token="DATA_TYPE" fg="4ec9b0" bold="true"/>
      <style token="ANNOTATION" fg="4ec9b0"/>

      <!-- Functions -->
      <style token="FUNCTION" fg="dcdcaa"/>

      <!-- Reserved words / keywords -->
      <style token="RESERVED_WORD" fg="569cd6" bold="true"/>
      <style token="RESERVED_WORD_2" fg="c586c0"/>

      <!-- Comments -->
      <style token="COMMENT_EOL" fg="6a9955" italic="true"/>
      <style token="COMMENT_MULTILINE" fg="6a9955" italic="true"/>
      <style token="COMMENT_DOCUMENTATION" fg="6a9955" italic="true"/>
      <style token="COMMENT_KEYWORD" fg="6a9955" italic="true"/>
      <style token="COMMENT_MARKUP" fg="969696" italic="true"/>

      <!-- Strings -->
      <style token="LITERAL_STRING_DOUBLE_QUOTE" fg="ce9178"/>
      <style token="LITERAL_CHAR" fg="ce9178"/>
      <style token="LITERAL_BACKQUOTE" fg="ce9178"/>

      <!-- Numbers -->
      <style token="LITERAL_NUMBER_DECIMAL_INT" fg="b5cea8"/>
      <style token="LITERAL_NUMBER_FLOAT" fg="b5cea8"/>
      <style token="LITERAL_NUMBER_HEXADECIMAL" fg="b5cea8"/>

      <!-- Booleans -->
      <style token="LITERAL_BOOLEAN" fg="569cd6" bold="true"/>

      <!-- Operators and separators -->
      <style token="OPERATOR" fg="d4d4d4"/>
      <style token="SEPARATOR" fg="d4d4d4"/>

      <!-- Preprocessor -->
      <style token="PREPROCESSOR" fg="c586c0"/>

      <!-- Regex -->
      <style token="REGEX" fg="d16969"/>

      <!-- Variables -->
      <style token="VARIABLE" fg="9cdcfe"/>

      <!-- Whitespace and errors -->
      <style token="WHITESPACE" fg="3c3c3c"/>
      <style token="ERROR_IDENTIFIER" fg="f44c4c"/>
      <style token="ERROR_NUMBER_FORMAT" fg="f44c4c"/>
      <style token="ERROR_STRING_DOUBLE" fg="f44c4c"/>
      <style token="ERROR_CHAR" fg="f44c4c"/>
   </tokenStyles>

</RSyntaxTheme>
