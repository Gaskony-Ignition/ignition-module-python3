# Flake8 Configuration for Python Bridge
# Enforces PEP 8 style guide with reasonable exceptions

[flake8]
max-line-length = 120
exclude =
    .git,
    __pycache__,
    build,
    dist,
    .eggs,
    *.egg-info,
    .venv,
    venv,
    .tox,
    .pytest_cache

# Error codes to ignore
ignore =
    # E203: whitespace before ':' (conflicts with black)
    E203,
    # E501: line too long (handled by max-line-length)
    E501,
    # W503: line break before binary operator (conflicts with black)
    W503,
    # E722: do not use bare 'except' (we use it intentionally for fallbacks)
    # E722

# Complexity thresholds
max-complexity = 15

# Enable specific warnings
select = C,E,F,W,B,B9

# Per-file ignores
per-file-ignores =
    # __init__.py files can have unused imports
    __init__.py:F401

# Show source code for errors
show-source = True

# Show pep8 code for errors
show-pep8 = True

# Count errors
count = True

# Statistics
statistics = True
